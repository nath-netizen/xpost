# --- Auth: Claude Code subscription (the brains of the harness) ---
# Locally, just run `claude login` once — no token needed here.
# For CI / non-interactive runs, mint a long-lived token with `claude setup-token`
# and set it as the CLAUDE_CODE_OAUTH_TOKEN secret (or here for a non-interactive
# local run). NOTE: if ANTHROPIC_API_KEY is set anywhere, it overrides the
# subscription — leave it unset to run on your plan.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional: model + run tuning ---
# Default keeps subscription usage low for frequent scheduled runs. For the most
# capable (heavier) model, set:
#   STP_MODEL=claude-opus-4-8
STP_MODEL=claude-sonnet-4-6
# How many candidate posts to generate per run (clamped to 1..20)
STP_POST_COUNT=12
# How far back the trend scan should look, in hours
STP_LOOKBACK_HOURS=24

# --- Optional: posting to X (only needed if you run `npm run post`) ---
# Create an app at https://developer.x.com (free tier allows posting).
# These are user-context OAuth 1.0a credentials.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
